{
  "name": "jellyclient",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone Jellyfin clients for Windows and VIDAA televisions.",
  "type": "module",
  "main": "out/main/index.js",
  "author": "JellyClient contributors",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "install-electron",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "package:win": "pnpm build && electron-builder --win nsis",
    "vidaa:probe": "vite --config VIDAA/vite.config.ts --host 0.0.0.0",
    "vidaa:build": "tsc --noEmit -p VIDAA/tsconfig.json && vite build --config VIDAA/vite.config.ts",
    "vidaa:start": "vite preview --config VIDAA/vite.config.ts --host 0.0.0.0 --strictPort",
    "vidaa:serve": "pnpm vidaa:build && pnpm vidaa:start",
    "vidaa:probe:tv": "pnpm vidaa:serve",
    "vidaa:preview": "pnpm vidaa:start",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@jellyfin/sdk": "0.13.0",
    "axios": "1.19.0",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "ws": "8.21.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "@playwright/test": "1.62.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.11.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.jellyclient.windows",
    "productName": "JellyClient",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "packageManager": "pnpm@11.9.0"
}
